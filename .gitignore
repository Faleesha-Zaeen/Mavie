# Try-on cache holds pre-signed S3 URLs that expire in two hours, so committing
# them would ship dead links. The LLM and skin caches are plain JSON and do
# make a keyless clone work, so those are kept.
server/.cache/vto-*.json

# Editor/agent tooling — local only
.claude/
