PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ─── Perfect Corp. / YouCam ─── server-side only, never expose to the client
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
YOUCAM_API_BASE=https://yce-api-01.perfectcorp.com

# ─── LLM ─── set ONE provider. "mock" runs a deterministic local reasoner.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ─── Supabase ─── optional. Omit to use the in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Unsplash ─── catalog photography (server-side only)
UNSPLASH_ACCESS_KEY=

# Public origin of the deployed app. Optional — try-on stages both images
# with Perfect Corp's file API rather than linking to them, so photoreal
# try-on works on localhost with no public host.
PUBLIC_BASE_URL=
