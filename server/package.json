{
  "name": "mavie-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "check:youcam": "node scripts/check-youcam.js",
    "find:youcam": "node scripts/find-youcam-host.js",
    "demo:record": "node scripts/record-demo.js",
    "demo:seed": "node -e \"fetch(`http://localhost:${process.env.PORT||5000}/api/demo/seed`,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).then(r=>r.json()).then(d=>console.log(d.seeded?'demo seeded':d))\"",
    "images:fetch": "node scripts/fetch-images.js",
    "preflight": "node scripts/preflight.js",
    "images:prune": "node scripts/prune-images.js",
    "discover": "node scripts/discover-endpoints.js",
    "test:all": "node scripts/test-all.js",
    "images:import": "node scripts/import-images.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.35.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  }
}
